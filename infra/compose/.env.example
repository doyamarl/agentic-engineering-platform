# Copy to infra/compose/.env to override the local defaults.
POSTGRES_PASSWORD=change-me
AEP_OWNER_DB_PASSWORD=change-me-too
AEP_APP_DB_PASSWORD=change-me-as-well
# Signs the access tokens of logged-in people; at least 32 bytes (the API refuses to start with
# less). Generate one with
# openssl rand -base64 48
AEP_ACCESS_TOKEN_SECRET=change-me
# Thread replies. With an Anthropic API key the worker answers with AEP_CHAT_MODEL; without one
# replies stay off. AEP_MODEL_PROVIDER=fake echoes each message instead, with no key.
# ANTHROPIC_API_KEY=
# AEP_MODEL_PROVIDER=fake
# Connectors (ADR-013), off by default; see compose.connectors.yaml. To turn them on:
# COMPOSE_FILE=compose.yaml:compose.connectors.yaml
# AEP_MASTER_KEY=   # 32 bytes in base64: openssl rand -base64 32
